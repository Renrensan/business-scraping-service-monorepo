# ==============================================================================
# MOMOS Scraper Service - Production Environment Configuration
# ==============================================================================

# Server & Environment
NODE_ENV=
PORT=
LOG_LEVEL=
LOG_FORMAT=

# Host Port Bindings (mapped to 127.0.0.1 on host machine)
FRONTEND_PORT=
BACKEND_PORT=
POSTGRES_PORT=
REDIS_PORT=

# Docker Hub Image Configuration
BACKEND_IMAGE=
FRONTEND_IMAGE=

# Database Credentials (PostgreSQL Container)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Redis Cache & Session Store Container
REDIS_URL=

# Application URLs & CORS
FRONTEND_URL=
FRONTEND_ORIGIN=
PUBLIC_API_URL=

# Initial Super Admin Auto-Bootstrapping (Used only on fresh DB)
SUPERADMIN_EMAIL=
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Worker & Extraction Engine Tuning
MAX_CONCURRENT_SCRAPERS=
MAX_CONCURRENT_ENRICHERS=
DEFAULT_USER_AGENT=

# Google Places API Key (Optional / Set if utilizing Google Places API)
GOOGLE_PLACES_API_KEY=

# Proxy Rotation List (Comma-separated: http://user:pass@host:port,http://...)
PROXIES=
