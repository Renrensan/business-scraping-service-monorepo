# ==============================================================================
# MOMOS Scraper Service - Production Environment Configuration
# ==============================================================================

# Server & Environment
NODE_ENV=
PORT=
LOG_LEVEL=
LOG_FORMAT=

# Host Port Bindings (mapped to 127.0.0.1 on host machine)
FRONTEND_PORT=
BACKEND_PORT=
POSTGRES_PORT=
REDIS_PORT=

# Docker Hub Image Configuration
BACKEND_IMAGE=
FRONTEND_IMAGE=

# Database Credentials (PostgreSQL Container)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Redis Cache & Session Store Container
REDIS_URL=

# Application URLs & CORS
FRONTEND_URL=
FRONTEND_ORIGIN=
PUBLIC_API_URL=

# Initial Super Admin Auto-Bootstrapping (Used only on fresh DB)
SUPERADMIN_EMAIL=
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Worker & Extraction Engine Tuning
MAX_CONCURRENT_SCRAPERS=
MAX_CONCURRENT_ENRICHERS=
DEFAULT_USER_AGENT=

# Google Places API Key (Optional / Set if utilizing Google Places API)
GOOGLE_PLACES_API_KEY=

# Proxy Rotation List (Comma-separated: http://user:pass@host:port,http://...)
PROXIES=

# --- Scraper reliability ---
# Seconds running jobs get to finish on shutdown/deploy before they are requeued (keep below stop_grace_period).
SHUTDOWN_GRACE_SECONDS=25
# Experimental Google Maps HTML scraper, used only without an API key or for engine "web". Off by default.
ENABLE_WEB_SCRAPER=false
# WhatsApp alerts (quota reached, failed jobs, keywords with no results) via Evolution API.
# Leave empty to only log alerts. From inside Docker, the host's Evolution API is reachable at
# http://host.docker.internal:8082 when the backend has extra_hosts: ["host.docker.internal:host-gateway"].
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
ALERT_WHATSAPP_NUMBER=
